SAARTHI_APP_NAME=Saarthi AI
SAARTHI_ENVIRONMENT=development
SAARTHI_OLLAMA_HOST=http://localhost:11434
SAARTHI_OLLAMA_MODEL=qwen3.5:9b
SAARTHI_REQUEST_TIMEOUT_SECONDS=180
# Verify TLS certificates on outbound requests to assessment targets.
# Authorized VAPT targets often have invalid/self-signed/expired certs, so
# this defaults to false (skip verification). Set to true to require valid certs.
SAARTHI_VERIFY_TLS=false
